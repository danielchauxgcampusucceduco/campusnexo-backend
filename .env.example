# Copy to .env for docker compose. Every value here is a placeholder: the real ones go only in .env (git-ignored).
POSTGRES_DB=campusnexo
POSTGRES_USER=campusnexo
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=jdbc:postgresql://database:5432/campusnexo
DATABASE_USER=campusnexo
DATABASE_PASSWORD=change-me-for-local-development
# Twin history in MongoDB (compose starts one; in production MongoDB Atlas). Empty = no history.
MONGODB_URI=mongodb://history:27017
# Comma-separated origins (patterns allowed) for CORS: the Vite dev server locally, the Vercel domains in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security. enforced: every call needs a session or a sensor key. development (laptop only): calls without
# credentials act as an administrator.
SECURITY_MODE=enforced
# local | production (production refuses SECURITY_MODE=development).
APP_ENVIRONMENT=local
# name:ROLE:hash, comma separated; ROLE = VIEWER | OPERATOR | ADMIN. Hashes: python3 tools/auth/hash_password.py
# Keep the value in single quotes: the hashes contain $, which docker compose would read as variables.
APP_USERS=''
# Keys (24+ characters) of cameras, Arduinos, computer agents and kiosks, one per device, comma separated.
APP_SENSOR_KEYS=
# Signing secret of the session tokens: add APP_TOKEN_SECRET to .env with 32+ random characters
# (e.g. `openssl rand -base64 48`). It has no default on purpose, so it never lands in a file like this one.
# CIDR networks allowed on /api/v1/admin/**, e.g. the VPN's public IP 203.0.113.7/32. Empty = any network, only
# outside production: with APP_ENVIRONMENT=production the backend refuses to start without it.
ADMIN_ALLOWED_NETWORKS=
# Proxies in front that append to X-Forwarded-For (0 locally, 1 on Render).
TRUSTED_PROXIES=0

AI_SERVICE_URL=http://ai:8001
# Same value as AI_API_KEY in the AI service (24+ characters). Empty only if the AI service has none.
AI_API_KEY=
AI_CONNECT_TIMEOUT=1s
AI_READ_TIMEOUT=2s
AI_TOOLS_READ_TIMEOUT=20s
AI_MAX_ATTEMPTS=2
AI_BACKOFF=100ms
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_DURATION=30s
AI_FALLBACK_ENABLED=true
# Variance of the camera count, from entrenamiento/ajustar_parametros.py of the AI service.
KALMAN_CAMERA_VARIANCE=0.64
OUTDOOR_CO2_PPM=420
CO2_ALERT_THRESHOLD_PPM=1000
EMPTY_SPACE_POWER_THRESHOLD_KW=0.15
ALERT_COOLDOWN=15m

# Timers. Campus values; for the pilot demonstration shorten them (e.g. 2m, 2m, 1m, 20s, 3s).
NO_SHOW_GRACE=15m
DESK_ABANDON_THRESHOLD=15m
EQUIPMENT_IDLE_SHUTDOWN=5m
EMPAREJAMIENTO_ANTICIPACION=75s
EMPAREJAMIENTO_RANURA=5s

# Edge telemetry and ESP32 commands over MQTT (compose starts a local Mosquitto broker).
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mqtt:1883
# Stable id of this instance for the broker's persistent session.
MQTT_INSTANCE_ID=compose
# log: orders reach only the log and the dashboard; mqtt: real ESP32/Arduino devices.
ACTUATORS_MODE=log
EMISSION_FACTOR_KG_CO2_PER_KWH=0.126
