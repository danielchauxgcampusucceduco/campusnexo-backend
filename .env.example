# Copy to .env for docker compose. Values are for local development only.
POSTGRES_DB=campusnexo
POSTGRES_USER=campusnexo
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=jdbc:postgresql://database:5432/campusnexo
DATABASE_USER=campusnexo
DATABASE_PASSWORD=change-me-for-local-development
SERVER_PORT=8080
# Comma-separated origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Shared key required in X-API-Key for POST /telemetry and reservations (empty = disabled locally).
INGEST_API_KEY=
AI_SERVICE_URL=http://host.docker.internal:8001
AI_CONNECT_TIMEOUT=2s
AI_READ_TIMEOUT=5s
AI_MAX_ATTEMPTS=2
AI_FALLBACK_ENABLED=true
OUTDOOR_CO2_PPM=420
CO2_ALERT_THRESHOLD_PPM=1000
EMPTY_SPACE_POWER_THRESHOLD_KW=0.15
ALERT_COOLDOWN=15m
RESERVATION_GRACE=15m
# Edge telemetry and ESP32 commands over MQTT (compose starts a local Mosquitto broker).
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mqtt:1883
# Live demonstration scenarios (POST /api/v1/simulation/{scenario}).
SIMULATION_ENABLED=true
EMISSION_FACTOR_KG_CO2_PER_KWH=0.126
