# Copy to .env for docker compose. Values are for local development only.
POSTGRES_DB=campusnexo
POSTGRES_USER=campusnexo
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=jdbc:postgresql://database:5432/campusnexo
DATABASE_USER=campusnexo
DATABASE_PASSWORD=change-me-for-local-development
SERVER_PORT=8080
# Comma-separated origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Security. development = calls without credentials act as a local administrator (laptop only).
# In any server use SECURITY_MODE=enforced with APP_USERS, APP_SENSOR_KEYS and APP_TOKEN_SECRET.
SECURITY_MODE=development
# local | production (production refuses SECURITY_MODE=development).
APP_ENVIRONMENT=local
# name:ROLE:hash, comma separated; hashes from: python3 tools/auth/hash_password.py
APP_USERS=
# Keys for cameras and boards (X-API-Key), 24+ characters each, comma separated.
APP_SENSOR_KEYS=
# 32+ random characters, e.g. `openssl rand -base64 48`.
APP_TOKEN_SECRET=
AI_SERVICE_URL=http://host.docker.internal:8001
# Same value as AI_API_KEY in the AI service (24+ characters). Empty only if the AI service has none.
AI_API_KEY=
AI_CONNECT_TIMEOUT=1s
AI_READ_TIMEOUT=2s
AI_MAX_ATTEMPTS=2
AI_BACKOFF=100ms
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_DURATION=30s
AI_FALLBACK_ENABLED=true
OUTDOOR_CO2_PPM=420
CO2_ALERT_THRESHOLD_PPM=1000
EMPTY_SPACE_POWER_THRESHOLD_KW=0.15
ALERT_COOLDOWN=15m
# Grace before an empty booked room counts as a no-show (twin status and RESERVA_SIN_USO alert).
NO_SHOW_GRACE=15m
# Edge telemetry and ESP32 commands over MQTT (compose starts a local Mosquitto broker).
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mqtt:1883
# Stable id of this instance for the broker's persistent session.
MQTT_INSTANCE_ID=compose
# Defense scenarios (ADMIN only). Actuator orders go to the log (ACTUATORS_MODE=log); the backend refuses
# to start with scenarios on and ACTUATORS_MODE=mqtt.
SIMULATION_ENABLED=true
ACTUATORS_MODE=log
EMISSION_FACTOR_KG_CO2_PER_KWH=0.126
